# Copy to gateway/.env (git-ignored, never pushed) and fill in.

# Langfuse tracing: base64 of "pk-lf-...:sk-lf-..."  (see agent/.env.example)
LANGFUSE_AUTH=...

# Signs and checks the JWT tokens. At least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=...

# Shared password of the demo users (alice, bob, carol, admin) for POST /token
DEMO_PASSWORD=...

# Password of the agent app's own account (support-agent, role SERVICE).
# Put the SAME value in agent/.env. Generate one with:  openssl rand -hex 16
AGENT_SERVICE_PASSWORD=...
