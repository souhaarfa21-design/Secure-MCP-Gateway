GROQ_API_KEY=your_key_here

# Langfuse (cloud.langfuse.com → Project Settings → API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# base64 of "public:secret". Generate it with:
#   echo -n "pk-lf-...:sk-lf-..." | base64 -w0
# Put the same LANGFUSE_AUTH line in gateway/.env too.
LANGFUSE_AUTH=...

# The agent's own gateway account (support-agent). SAME value as in gateway/.env
AGENT_SERVICE_PASSWORD=...
